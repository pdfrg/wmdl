# wmdl-discover.service — oneshot unit for wmdl discover
#
# Install:
#   cp contrib/wmdl-discover.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#
# Paths: ExecStart points at the standard install location (~/.local/bin/wmdl,
# e.g. `go build -o ~/.local/bin/wmdl ./cmd/wmdl`). Adjust it to match your
# `which wmdl` or build output.
# Requires: a working $HOME/.config/wmdl/config.yaml.
#
# NOTE: --headless is intentionally omitted. AllMusic (Cloudflare) blocks
# headless browsers, so Brave runs as a normal GUI window at 5 AM.
# Brave uses --window-position=10000,10000 to stay off-screen if needed,
# or you can add it manually to ExecStart.

[Unit]
Description=wmdl — weekly media discovery
Documentation=https://github.com/pdfrg/wmdl
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/wmdl discover

# Hardening (minimal — user namespacing from ProtectSystem/ReadWritePaths
# breaks SSH config file permission checks for hooks that use SSH)
