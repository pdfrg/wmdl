# wmdl-discover.timer — runs wmdl discover every Wednesday at 05:00
#
# Install:
#   cp contrib/wmdl-discover.service  ~/.config/systemd/user/
#   cp contrib/wmdl-discover.timer    ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now wmdl-discover.timer
#
# Check:
#   systemctl --user list-timers
#   journalctl --user -u wmdl-discover.service --since today

[Unit]
Description=Run wmdl discover every Wednesday
Documentation=https://github.com/pdfrg/wmdl

[Timer]
OnCalendar=Wed 05:00
Persistent=true

# If the previous run was missed (e.g. machine off), Persistent=true
# triggers it immediately on the next boot — regardless of how late.
# AccuracySec just lets systemd coalesce wake-ups within this window;
# it does NOT impose a deadline for the missed-trigger.
AccuracySec=1h

[Install]
WantedBy=timers.target
